// ============================================================================
// Campus Hustle - Production Prisma Schema
// Target Database: PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum HustleType {
  SERVICE
  PRODUCT
}

enum PriceType {
  FLAT
  STARTING_AT
  HOURLY
  NEGOTIABLE
}

enum DeliveryMode {
  TO_CLIENT
  AT_SELLER
  CAMPUS_SPOT
  REMOTE
}

enum HustleStatus {
  ACTIVE
  PAUSED
  BUSY
  SOLD_OUT
  UNDER_REVIEW
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  IN_PROGRESS
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  CANCELLED
  REFUNDED
}

// DEPRECATED: Retained for historical record compatibility.
// Financial architecture v1 uses explicit Payout and Refund models instead of internal wallet escrow.
enum EscrowStatus {
  HELD
  RELEASED_TO_SELLER
  REFUNDED_TO_BUYER
  DISPUTED
}

enum PayoutStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REQUIRES_REVIEW
}

enum RefundStatus {
  NOT_REQUESTED
  REQUESTED
  PROCESSING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  MANUAL_SIMULATION
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentMethod {
  MTN_MOMO
  TELECEL_CASH
  AIRTEL_TIGO_MONEY
  CARD
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum ReportReason {
  SCAM_OR_FRAUD
  INAPPROPRIATE_CONTENT
  HARASSMENT
  POOR_QUALITY
  WRONG_CAMPUS
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  ACTIONED
  DISMISSED
}

// ----------------------------------------------------------------------------
// 1. CAMPUS & USER DOMAIN
// ----------------------------------------------------------------------------

model University {
  id               String       @id @default(cuid())
  code             String       @unique // "KNUST", "UG", "UCC", "UMAT", "UHAS"
  name             String
  shortName        String
  city             String
  allowedDomains   String[]     // E.g. ["st.knust.edu.gh"]
  popularLocations String[]     // E.g. ["Ayeduase", "Kotei", "Brunei", "CCB", "Gaza"]
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users            User[]
  hustles          Hustle[]

  @@index([isActive])
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  phoneNumber    String?        @unique
  phoneVerified  Boolean        @default(false)
  passwordHash   String
  name           String
  program        String
  hostelLocation String
  avatarUrl      String?
  role           UserRole       @default(STUDENT)
  tokenVersion   Int            @default(1)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  universityId   String
  university     University     @relation(fields: [universityId], references: [id])

  sellerProfile  SellerProfile?
  cart           Cart?
  orders         Order[]        @relation("BuyerOrders")
  reviews        Review[]       @relation("BuyerReviews")
  favorites      Favorite[]
  notifications  Notification[]
  reportsFiled   Report[]       @relation("ReporterUser")
  reportsAgainst Report[]       @relation("ReportedUser")
  moderationLogs ModerationLog[]

  @@index([universityId])
  @@index([email])
  @@index([phoneNumber])
}

model SellerProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName          String?
  bio                   String?        @db.Text
  payoutMomoNumber      String
  payoutMomoNetwork      PaymentMethod  @default(MTN_MOMO)
  isVerifiedSeller      Boolean        @default(false)
  totalSalesCount       Int            @default(0)

  // Paystack Transfer Recipient Details
  paystackRecipientCode String?        // Paystack Transfer Recipient code (e.g. RCP_xxxxx)
  verifiedAccountName   String?        // Verified MoMo Account Name from provider
  isPayoutVerified      Boolean        @default(false)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  hustles               Hustle[]
  subOrders             SubOrder[]     @relation("SellerSubOrders")
  payouts               Payout[]

  @@index([userId])
}

model OTPVerification {
  id            String      @id @default(cuid())
  identifier    String      // Email or E.164 phone
  otpCodeHash   String      // BCRYPT hash of the code
  purpose       OtpPurpose
  expiresAt     DateTime
  attempts      Int         @default(0)
  maxAttempts   Int         @default(5)
  isVerified    Boolean     @default(false)
  isInvalidated Boolean     @default(false) // Set when superseded by a new code
  consumedAt    DateTime?                   // Timestamp when verified
  invalidatedAt DateTime?                   // Timestamp when superseded
  createdAt     DateTime    @default(now())

  @@index([identifier, purpose, isVerified, isInvalidated, expiresAt])
}

// ----------------------------------------------------------------------------
// 2. CATALOG & HUSTLE DOMAIN
// ----------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  icon      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  hustles   Hustle[]
}

model Hustle {
  id              String       @id @default(cuid())
  title           String       @db.VarChar(200)
  description     String       @db.Text
  type            HustleType   @default(SERVICE)
  price           Decimal      @db.Decimal(10, 2)
  priceType       PriceType    @default(FLAT)
  deliveryMode    DeliveryMode @default(TO_CLIENT)
  status          HustleStatus @default(ACTIVE)
  
  trackStock      Boolean      @default(false)
  stockQuantity   Int          @default(0)

  hostelLocation  String
  whatsAppContact String

  ratingAverage   Decimal      @default(5.0) @db.Decimal(3, 2)
  ratingCount     Int          @default(0)
  isFeatured      Boolean      @default(false)
  tags            String[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  universityId    String
  university      University    @relation(fields: [universityId], references: [id])

  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])

  images          HustleImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  favorites       Favorite[]
  reports         Report[]

  @@index([universityId, status, categoryId])
  @@index([universityId, isFeatured, createdAt(sort: Desc)])
  @@index([universityId, price])
  @@index([universityId, ratingAverage(sort: Desc)])
  @@index([universityId, hostelLocation])
  @@index([universityId, createdAt(sort: Desc)])
  @@index([sellerProfileId])
}

model HustleImage {
  id           String   @id @default(cuid())
  hustleId     String
  hustle       Hustle   @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  imageUrl     String
  thumbnailUrl String?
  publicId     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([hustleId, sortOrder])
  @@index([publicId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hustleId  String
  hustle    Hustle   @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hustleId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// 3. CART & COMMERCE DOMAIN
// ----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  hustleId  String
  hustle    Hustle   @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, hustleId])
}

// ----------------------------------------------------------------------------
// 4. MULTI-SELLER ORDERS & ESCROW DOMAIN
// ----------------------------------------------------------------------------

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique // "CH-KNUST-2026-00123"
  buyerId             String
  buyer               User                 @relation("BuyerOrders", fields: [buyerId], references: [id])
  
  totalAmount         Decimal              @db.Decimal(10, 2)
  currency            String               @default("GHS")
  status              OrderStatus          @default(PENDING_PAYMENT)
  
  idempotencyKey      String?              @unique
  campusCode          String?
  contactPhone        String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  subOrders           SubOrder[]
  payments            Payment[]
  payouts             Payout[]
  refunds             Refund[]
  platformCommissions PlatformCommission[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@index([idempotencyKey])
}

model SubOrder {
  id                  String               @id @default(cuid())
  subOrderNumber      String               @unique // "CH-KNUST-2026-00123-A"
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sellerProfileId     String
  sellerProfile       SellerProfile        @relation("SellerSubOrders", fields: [sellerProfileId], references: [id])

  status              SubOrderStatus       @default(PENDING_ACCEPTANCE)
  
  // DEPRECATED: Retained for backward compatibility with existing records and tests.
  // Financial architecture v1 uses explicit Payout and Refund models instead of internal wallet escrow.
  escrowStatus        EscrowStatus         @default(HELD)

  subtotal            Decimal              @db.Decimal(10, 2)
  deliveryMode        DeliveryMode         @default(TO_CLIENT)
  meetupLocation      String
  deliveryAddress     String?
  notesToSeller       String?              @db.Text
  
  // Commission snapshot fields (persisted per transaction so rate changes never alter history)
  commissionRate      Decimal?             @default(0.0500) @db.Decimal(5, 4)
  commissionAmount    Decimal?             @default(0.00) @db.Decimal(10, 2)
  netSellerAmount     Decimal?             @default(0.00) @db.Decimal(10, 2)

  acceptedAt          DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  cancelledByUserId   String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  items               OrderItem[]
  payout              Payout?
  refunds             Refund[]
  platformCommissions PlatformCommission[]

  @@index([sellerProfileId, status])
  @@index([orderId])
  @@index([subOrderNumber])
}

model OrderItem {
  id            String    @id @default(cuid())
  subOrderId    String
  subOrder      SubOrder  @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  
  hustleId      String?
  hustle        Hustle?   @relation(fields: [hustleId], references: [id], onDelete: SetNull)

  snapshotTitle String
  snapshotPrice Decimal   @db.Decimal(10, 2)
  quantity      Int       @default(1)
  lineTotal     Decimal   @db.Decimal(10, 2)

  review        Review?

  @@index([subOrderId])
}

model Payment {
  id                  String               @id @default(cuid())
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id])
  
  reference           String               @unique
  providerReference   String?              // Gateway transaction ID / reference
  provider            PaymentProvider      @default(PAYSTACK)
  idempotencyKey      String?              @unique
  amount              Decimal              @db.Decimal(10, 2)
  currency            String               @default("GHS")
  paymentMethod       PaymentMethod        @default(MTN_MOMO)
  momoNumber          String
  status              PaymentStatus        @default(INITIALIZED)
  
  gatewayResponse     String?
  paidAt              DateTime?
  rawMetadata         Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  refunds             Refund[]
  platformCommissions PlatformCommission[]

  @@index([reference])
  @@index([orderId])
  @@index([providerReference])
}

// ----------------------------------------------------------------------------
// 4B. PLATFORM SETTINGS, PAYOUTS, COMMISSIONS & REFUNDS DOMAIN
// ----------------------------------------------------------------------------

model PlatformConfig {
  id               String   @id @default(cuid())
  configKey        String   @unique @default("DEFAULT")
  commissionRate   Decimal  @default(0.0500) @db.Decimal(5, 4) // e.g. 0.0500 = 5%
  isPayoutsEnabled Boolean  @default(true)
  payoutHoldHours  Int      @default(24) // Hold period in hours before settlement eligibility
  minPayoutAmount  Decimal  @default(1.00) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PlatformCommission {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId       String?
  subOrder         SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  rateApplied      Decimal   @db.Decimal(5, 4) // Actual rate snapshot applied (e.g. 0.0500)
  grossAmount      Decimal   @db.Decimal(10, 2)
  commissionAmount Decimal   @db.Decimal(10, 2)
  netSellerAmount  Decimal   @db.Decimal(10, 2)
  currency         String    @default("GHS")

  recordedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId])
  @@index([subOrderId])
  @@index([paymentId])
  @@index([recordedAt])
}

model Payout {
  id                    String          @id @default(cuid())
  subOrderId            String          @unique
  subOrder              SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sellerProfileId       String
  sellerProfile         SellerProfile   @relation(fields: [sellerProfileId], references: [id])

  grossAmount           Decimal         @db.Decimal(10, 2) // SubOrder subtotal
  commissionAmount      Decimal         @db.Decimal(10, 2) // Platform commission retained
  payoutAmount          Decimal         @db.Decimal(10, 2) // Net seller payout (gross - commission)
  currency              String          @default("GHS")

  recipientIdentifier   String          // MoMo account phone number
  recipientName         String?         // Account name verified by Paystack
  providerRecipientCode String?         // Paystack Transfer Recipient code (RCP_xxxx)

  provider              PaymentProvider @default(PAYSTACK)
  providerReference     String?         // Paystack Transfer code/reference (TRF_xxxx)
  idempotencyKey        String          @unique // Payout idempotency reference

  status                PayoutStatus    @default(PENDING)
  failureReason         String?         @db.Text

  eligibleAt            DateTime?       // When settlement becomes eligible after delivery hold
  initiatedAt           DateTime?       // When transfer request was sent to gateway
  confirmedAt           DateTime?       // When gateway confirmed transfer success/failure

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([sellerProfileId, status])
  @@index([orderId])
  @@index([subOrderId])
  @@index([status, eligibleAt])
  @@index([providerReference])
  @@index([idempotencyKey])
}

model Refund {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId        String?
  subOrder          SubOrder?       @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  paymentId         String
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("GHS")

  provider          PaymentProvider @default(PAYSTACK)
  providerReference String?         // Gateway refund reference
  idempotencyKey    String          @unique // Refund idempotency key

  status            RefundStatus    @default(NOT_REQUESTED)
  reason            String          @db.Text
  failureReason     String?         @db.Text

  requestedAt       DateTime        @default(now())
  processedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([subOrderId])
  @@index([paymentId])
  @@index([status])
  @@index([providerReference])
  @@index([idempotencyKey])
}

model WebhookEvent {
  id           String             @id @default(cuid())
  provider     PaymentProvider    @default(PAYSTACK)
  eventId      String             @unique // Unique event ID / signature hash for strict idempotency
  eventType    String             // e.g. "charge.success", "transfer.success", "transfer.failed"
  status       WebhookEventStatus @default(RECEIVED)
  payload      Json
  errorMessage String?            @db.Text
  processedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// 5. REVIEWS, NOTIFICATIONS & MODERATION
// ----------------------------------------------------------------------------

model Review {
  id          String     @id @default(cuid())
  hustleId    String
  hustle      Hustle     @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  
  reviewerId  String
  reviewer    User       @relation("BuyerReviews", fields: [reviewerId], references: [id])

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  rating      Int
  comment     String     @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([hustleId, createdAt(sort: Desc)])
  @@index([hustleId, rating])
  @@index([reviewerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReporterUser", fields: [reporterId], references: [id])
  
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])

  hustleId       String?
  hustle         Hustle?      @relation(fields: [hustleId], references: [id])

  reason         ReportReason
  details        String       @db.Text
  status         ReportStatus @default(PENDING)
  adminNotes     String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([hustleId])
}

model ModerationLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  targetId  String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([adminId])
}
