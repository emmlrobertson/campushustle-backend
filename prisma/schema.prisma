// ============================================================================
// Campus Hustle - Production Prisma Schema
// Target Database: PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum HustleType {
  SERVICE
  PRODUCT
}

enum PriceType {
  FLAT
  STARTING_AT
  HOURLY
  NEGOTIABLE
}

enum DeliveryMode {
  TO_CLIENT
  AT_SELLER
  CAMPUS_SPOT
  REMOTE
}

enum HustleStatus {
  ACTIVE
  PAUSED
  BUSY
  SOLD_OUT
  UNDER_REVIEW
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  IN_PROGRESS
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum EscrowStatus {
  HELD
  RELEASED_TO_SELLER
  REFUNDED_TO_BUYER
  DISPUTED
}

enum PaymentMethod {
  MTN_MOMO
  TELECEL_CASH
  AIRTEL_TIGO_MONEY
  CARD
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum ReportReason {
  SCAM_OR_FRAUD
  INAPPROPRIATE_CONTENT
  HARASSMENT
  POOR_QUALITY
  WRONG_CAMPUS
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  ACTIONED
  DISMISSED
}

// ----------------------------------------------------------------------------
// 1. CAMPUS & USER DOMAIN
// ----------------------------------------------------------------------------

model University {
  id               String       @id @default(cuid())
  code             String       @unique // "KNUST", "UG", "UCC", "UMAT", "UHAS"
  name             String
  shortName        String
  city             String
  allowedDomains   String[]     // E.g. ["st.knust.edu.gh"]
  popularLocations String[]     // E.g. ["Ayeduase", "Kotei", "Brunei", "CCB", "Gaza"]
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users            User[]
  hustles          Hustle[]

  @@index([isActive])
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  phoneNumber    String?        @unique
  phoneVerified  Boolean        @default(false)
  passwordHash   String
  name           String
  program        String
  hostelLocation String
  avatarUrl      String?
  role           UserRole       @default(STUDENT)
  tokenVersion   Int            @default(1)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  universityId   String
  university     University     @relation(fields: [universityId], references: [id])

  sellerProfile  SellerProfile?
  cart           Cart?
  orders         Order[]        @relation("BuyerOrders")
  reviews        Review[]       @relation("BuyerReviews")
  favorites      Favorite[]
  notifications  Notification[]
  reportsFiled   Report[]       @relation("ReporterUser")
  reportsAgainst Report[]       @relation("ReportedUser")
  moderationLogs ModerationLog[]

  @@index([universityId])
  @@index([email])
  @@index([phoneNumber])
}

model SellerProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName     String?
  bio              String?       @db.Text
  payoutMomoNumber String
  payoutMomoNetwork PaymentMethod @default(MTN_MOMO)
  isVerifiedSeller Boolean       @default(false)
  totalSalesCount  Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  hustles          Hustle[]
  subOrders        SubOrder[]    @relation("SellerSubOrders")

  @@index([userId])
}

model OTPVerification {
  id            String      @id @default(cuid())
  identifier    String      // Email or E.164 phone
  otpCodeHash   String      // BCRYPT hash of the code
  purpose       OtpPurpose
  expiresAt     DateTime
  attempts      Int         @default(0)
  maxAttempts   Int         @default(5)
  isVerified    Boolean     @default(false)
  isInvalidated Boolean     @default(false) // Set when superseded by a new code
  consumedAt    DateTime?                   // Timestamp when verified
  invalidatedAt DateTime?                   // Timestamp when superseded
  createdAt     DateTime    @default(now())

  @@index([identifier, purpose, isVerified, isInvalidated, expiresAt])
}

// ----------------------------------------------------------------------------
// 2. CATALOG & HUSTLE DOMAIN
// ----------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  icon      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  hustles   Hustle[]
}

model Hustle {
  id              String       @id @default(cuid())
  title           String       @db.VarChar(200)
  description     String       @db.Text
  type            HustleType   @default(SERVICE)
  price           Decimal      @db.Decimal(10, 2)
  priceType       PriceType    @default(FLAT)
  deliveryMode    DeliveryMode @default(TO_CLIENT)
  status          HustleStatus @default(ACTIVE)
  
  trackStock      Boolean      @default(false)
  stockQuantity   Int          @default(0)

  hostelLocation  String
  whatsAppContact String

  ratingAverage   Decimal      @default(5.0) @db.Decimal(3, 2)
  ratingCount     Int          @default(0)
  isFeatured      Boolean      @default(false)
  tags            String[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  universityId    String
  university      University    @relation(fields: [universityId], references: [id])

  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])

  images          HustleImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  favorites       Favorite[]
  reports         Report[]

  @@index([universityId, status, categoryId])
  @@index([universityId, isFeatured, createdAt(sort: Desc)])
  @@index([universityId, price])
  @@index([universityId, ratingAverage(sort: Desc)])
  @@index([universityId, hostelLocation])
  @@index([universityId, createdAt(sort: Desc)])
  @@index([sellerProfileId])
}

model HustleImage {
  id           String   @id @default(cuid())
  hustleId     String
  hustle       Hustle   @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  imageUrl     String
  thumbnailUrl String?
  publicId     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([hustleId, sortOrder])
  @@index([publicId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hustleId  String
  hustle    Hustle   @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hustleId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// 3. CART & COMMERCE DOMAIN
// ----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  hustleId  String
  hustle    Hustle   @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, hustleId])
}

// ----------------------------------------------------------------------------
// 4. MULTI-SELLER ORDERS & ESCROW DOMAIN
// ----------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // "CH-KNUST-2026-00123"
  buyerId        String
  buyer          User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  
  totalAmount    Decimal     @db.Decimal(10, 2)
  currency       String      @default("GHS")
  status         OrderStatus @default(PENDING_PAYMENT)
  
  idempotencyKey String?     @unique
  campusCode     String?
  contactPhone   String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subOrders      SubOrder[]
  payments       Payment[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@index([idempotencyKey])
}

model SubOrder {
  id                 String         @id @default(cuid())
  subOrderNumber     String         @unique // "CH-KNUST-2026-00123-A"
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sellerProfileId    String
  sellerProfile      SellerProfile  @relation("SellerSubOrders", fields: [sellerProfileId], references: [id])

  status             SubOrderStatus @default(PENDING_ACCEPTANCE)
  escrowStatus       EscrowStatus   @default(HELD)

  subtotal           Decimal        @db.Decimal(10, 2)
  deliveryMode       DeliveryMode   @default(TO_CLIENT)
  meetupLocation     String
  deliveryAddress    String?
  notesToSeller      String?        @db.Text
  
  acceptedAt         DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledByUserId  String?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items              OrderItem[]

  @@index([sellerProfileId, status])
  @@index([orderId])
  @@index([subOrderNumber])
}

model OrderItem {
  id            String    @id @default(cuid())
  subOrderId    String
  subOrder      SubOrder  @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  
  hustleId      String?
  hustle        Hustle?   @relation(fields: [hustleId], references: [id], onDelete: SetNull)

  snapshotTitle String
  snapshotPrice Decimal   @db.Decimal(10, 2)
  quantity      Int       @default(1)
  lineTotal     Decimal   @db.Decimal(10, 2)

  review        Review?

  @@index([subOrderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  
  reference       String        @unique
  idempotencyKey  String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("GHS")
  paymentMethod   PaymentMethod @default(MTN_MOMO)
  momoNumber      String
  status          PaymentStatus @default(INITIALIZED)
  
  gatewayResponse String?
  paidAt          DateTime?
  rawMetadata     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([reference])
  @@index([orderId])
}

// ----------------------------------------------------------------------------
// 5. REVIEWS, NOTIFICATIONS & MODERATION
// ----------------------------------------------------------------------------

model Review {
  id          String     @id @default(cuid())
  hustleId    String
  hustle      Hustle     @relation(fields: [hustleId], references: [id], onDelete: Cascade)
  
  reviewerId  String
  reviewer    User       @relation("BuyerReviews", fields: [reviewerId], references: [id])

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  rating      Int
  comment     String     @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([hustleId, createdAt(sort: Desc)])
  @@index([hustleId, rating])
  @@index([reviewerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReporterUser", fields: [reporterId], references: [id])
  
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])

  hustleId       String?
  hustle         Hustle?      @relation(fields: [hustleId], references: [id])

  reason         ReportReason
  details        String       @db.Text
  status         ReportStatus @default(PENDING)
  adminNotes     String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([hustleId])
}

model ModerationLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  targetId  String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([adminId])
}
