{
  "name": "campushustle-backend",
  "version": "1.0.0",
  "description": "REST API Server for CampusHustle KNUST Student Side-Hustle Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc --skipLibCheck",
    "postinstall": "prisma generate && tsc --skipLibCheck",
    "start": "node dist/server.js",
    "db:init": "ts-node src/db/initDb.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node src/db/seed.ts",
    "prisma:studio": "prisma studio",
    "db:migrate-sqlite": "ts-node src/db/migrateSqliteToPostgres.ts",
    "db:verify": "ts-node src/db/verifyDb.ts",
    "test:auth": "ts-node src/db/testAuthFlow.ts",
    "test:hustle": "ts-node src/db/testHustleSecurity.ts",
    "test:upload": "ts-node src/db/testImageUploadSecurity.ts",
    "test:orders": "ts-node src/db/testOrderArchitecture.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "prisma": "^6.4.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "typescript": "^5.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.24",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
