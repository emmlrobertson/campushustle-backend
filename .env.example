# Campus Hustle Backend - Environment Variables Example
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/campushustle?schema=public"

# JWT Authentication
JWT_SECRET="replace_with_a_long_random_entropy_secret_key_in_production"

# Ghana BMS Africa / mNotify SMS Provider Configuration
MNOTIFY_API_KEY="your_bms_africa_api_key_here"
BMS_SENDER_ID="CampHustle"

# Development Flags (Strictly Disabled in Production)
ALLOW_MOCK_SMS=false
DEV_OTP_MODE=false
OTP_EXPIRY_MINUTES=10

# Paystack Payment Gateway (Test or Live Secret Key)
PAYSTACK_SECRET_KEY=""

# Cloudinary Media Storage (CDN for Hustle Images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
