# ==============================================================================
# Campus Hustle Backend - Environment Variables Example
# Safe template containing variable names with safe placeholders only.
# Do not commit real credential values here.
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=

# Authentication (Minimum 32 characters in production)
JWT_SECRET=

# Payment Gateway (Paystack)
PAYSTACK_SECRET_KEY=

# Cloud Media Storage (Cloudinary CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS Gateway (BMS Africa / mNotify)
MNOTIFY_API_KEY=
BMS_SENDER_ID=CampHustle

# Development Flags (Strictly disabled in production)
ALLOW_MOCK_SMS=false
DEV_OTP_MODE=false
OTP_EXPIRY_MINUTES=10
DEV_PAYMENT_SIMULATION=false

# Client Web Application URL
FRONTEND_URL=https://campushustle-mobile.vercel.app
